# Base ETH Faucet Environment Variables

# Pimlico API Key (for gasless transactions)
# Get from: https://www.pimlico.io/
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key_here

# WalletConnect/Reown Project ID (REQUIRED for wallet connections)
# Get from: https://cloud.walletconnect.com/ or https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_REOWN_PROJECT_ID=your_project_id_here

# Faucet Contract Address (deployed contract on Base Sepolia)
NEXT_PUBLIC_FAUCET_CONTRACT_ADDRESS=0x527585EE01F9a86B895b98Fb59E14d8C943cF6db

# Privy App ID (for Farcaster auth)
# Get from: https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Mock Mode (set to true for testing without blockchain)
NEXT_PUBLIC_MOCK_MODE=false
